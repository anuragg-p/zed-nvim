 [ {
    "label": "mkroot",
    "command": "mkroot; exec $SHELL -i", // exec $SHELL -i will just create a new shell so you can use the shell afterwards
    "args": [],
    "cwd": "$ZED_DIRNAME",
    "shell": "system",
    "use_new_terminal": false,
    "reveal": "always",
    "hide": "never",
    "allow_concurrent_runs": true,
    "show_summary": false
  }
 ]

